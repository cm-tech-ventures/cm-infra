# Copie para terraform.tfvars (ignorado pelo git) antes do plan/apply.
#
# Estes valores são os que estão EM PRODUÇÃO hoje, reconstruídos a partir do
# state em 29/09/2026. Até então não estavam escritos em lugar nenhum: quem
# aplicasse o bootstrap sem eles via o Terraform propor DESTRUIR permissões
# reais (as ligações WIF de cada repo, o acesso do sink do md-hom, o papel de
# logging do deployer). Foi por isso que o bootstrap ficou marcado como
# "não aplicar". Nada aqui é segredo — são identificadores, não credenciais.
#
# Conferir com:
#   terraform state list
#   gcloud projects get-iam-policy cm-ventures-core

project_id        = "cm-ventures-core"
github_owner      = "cm-tech-ventures"
state_bucket_name = "cm-ventures-core-tfstate"

# Repos autorizados a assumir a SA de deploy via Workload Identity Federation.
#
# cm-analytics, cm-billing e cm-docs tiveram o binding criado a mao com
# `gcloud iam service-accounts add-iam-policy-binding`. Entraram nesta lista
# em cm-infra#73, junto de um `import {}` em imports.tf: o plan os adota sem
# mudar nada na nuvem. cm-backoffice e cm-backoffice-frontend ja estavam no
# state (02/10 e 06/10) e faltavam aqui.
#
# Conferir a realidade com:
#   gcloud iam service-accounts get-iam-policy \
#     github-deployer-prod@cm-ventures-core.iam.gserviceaccount.com \
#     --project=cm-ventures-core
github_repositories = [
  "cm-tech-ventures/cm-analytics",
  "cm-tech-ventures/cm-backoffice",
  "cm-tech-ventures/cm-backoffice-frontend",
  "cm-tech-ventures/cm-billing",
  "cm-tech-ventures/cm-crm",
  "cm-tech-ventures/cm-docs",
  "cm-tech-ventures/cm-identity",
  "cm-tech-ventures/cm-infra",
  "cm-tech-ventures/cm-mcp",
  "cm-tech-ventures/cm-sdk",
  "cm-tech-ventures/cm-service-template",
]

# Quem pode assumir a SA cm-ops-observer por impersonation (CMV-319).
ops_observer_impersonators = ["user:cm.tech.ventures@gmail.com"]

# Quem pode assumir a SA analytics-bq-metabase (Metabase local, plataforma de
# dados fase 3). Binding na SA, não no projeto.
metabase_impersonators = ["user:cm.tech.ventures@gmail.com"]

# Billing account do core, para conceder roles/billing.viewer à cm-ops-observer.
billing_account_id = "013EE2-6E67DB-A423CD"

# Writer identities de sinks cross-project que escrevem no dataset raw_mcp_logs.
# Vazio desde a E9 (cm-infra#87): o md-mcp (md-hom) migrou para o envelope novo
# (mcp.tool_call -> bronze_logs, md-backend#367/#369) e o sink antigo foi removido.
# O sink do core cm-mcp-tool-calls-to-bq e o dataset ficam ate o cm-mcp migrar.
mcp_logs_external_sink_writer_identities = []

# Leitura cruzada de secrets do core por SAs do MD e do bjj (cm-infra#73).
# Concedidas a mao; importadas em imports.tf. Ficaram DE FORA, de proposito,
# os secretmanager.admin cruzados nos mesmos secrets (saem na E5 do #70):
#   identity-introspection-core-key:     implantacao-homolog@md-hom, sys-bjj-mcp-deploy@bjj-system
#   identity-hom-introspection-core-key: implantacao-homolog@md-hlg, sys-bjj-mcp-deploy@bjj-system
#
# Conferir com:
#   gcloud secrets get-iam-policy <secret> --project=cm-ventures-core
secrets_leitores_externos = {
  "identity-introspection-core-key" = [
    "serviceAccount:implantacao-homolog@md-hom.iam.gserviceaccount.com",
    "serviceAccount:implantacao-prod@md-prd-490503.iam.gserviceaccount.com",
    "serviceAccount:md-mcp-run@md-hom.iam.gserviceaccount.com",
    "serviceAccount:sys-bjj-mcp-run@bjj-system.iam.gserviceaccount.com",
  ]
  "identity-hom-introspection-core-key" = [
    "serviceAccount:implantacao-homolog@md-hlg.iam.gserviceaccount.com",
    "serviceAccount:md-mcp-run@md-hlg.iam.gserviceaccount.com",
    "serviceAccount:sys-bjj-mcp-hom-run@bjj-system.iam.gserviceaccount.com",
  ]
  "identity-org-meus-dredinhos-api-key" = [
    "serviceAccount:implantacao-homolog@md-hom.iam.gserviceaccount.com",
    "serviceAccount:implantacao-prod@md-prd-490503.iam.gserviceaccount.com",
  ]
  "identity-hom-org-meus-dredinhos-api-key" = [
    "serviceAccount:implantacao-homolog@md-hlg.iam.gserviceaccount.com",
  ]
}

# Retenção do Artifact Registry: false = apaga de verdade.
#
# A variável tem default true (dry run) de propósito, para que um projeto novo
# nasça sem risco. Aqui é false porque o alcance foi medido em 30/09/2026:
# resolvendo tag->digest nas 445 imagens do cm-cores, nenhuma imagem viva cai —
# nem o keepalive-check, que tem uma única, de 15/07. Apaga 297 versões.
retencao_dry_run = false
